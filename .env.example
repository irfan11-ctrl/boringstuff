# Copy these values into your hosting provider's environment settings.
BORINGSTUFF_ENV=production
BORINGSTUFF_SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_SECRET
BORINGSTUFF_ALLOWED_HOSTS=www.example.com,example.com
BORINGSTUFF_PUBLIC_BASE_URL=https://www.example.com

# Gemini Developer API (keep this key private; never put it in frontend code)
GEMINI_API_KEY=AQ.Ab8RN6JwHYuoI8G_RCmykT7Ibs7IWtgiMYrW81mw6qAAVpfgiw
GEMINI_MODEL=gemini-3.5-flash

# Optional
BORINGSTUFF_CONTACT_EMAIL=vantagesolve@gmail.com
# Number of reverse proxies in front of the app (Railway/Render/Nginx = 1). Needed for the per-IP AI limit.
BORINGSTUFF_TRUSTED_PROXIES=1
# Set to 1 only if you want the retired caption and PDF-compress endpoints back.
BORINGSTUFF_LEGACY_TOOLS=0
